BUSINESSES_PROVIDER=geoapify
GEOAPIFY_API_KEY=

# Supabase. A chave publicável atende o login e as consultas do usuário
# (protegidas por RLS); a secreta ignora o RLS e só é usada em tarefas
# administrativas no servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gera o resumo da oportunidade e a mensagem de abordagem (opcional:
# sem ela os textos saem do template local)
GEMINI_API_KEY=

# Alternativa oficial do Google (opcional)
GOOGLE_MAPS_API_KEY=
